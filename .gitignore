# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
Thumbs.db
desktop.ini
*.tmp
*.bak

# IntelliJ / JetBrains
# (a handful of shared project files were committed in the initial commit;
# this just stops new IDE-local clutter — workspace.xml, caches, shelf, etc. —
# from being picked up going forward)
.idea/
.idea/shelf/
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/httpRequests/
*.ipr
*.iws

# VS Code
# The .vscode folder can hold shared launch/task config, so it's not blanket-ignored —
# just the machine-local bits.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Flutter / Dart / Pub
# (the app itself hasn't been scaffolded yet — see docs/development/foundations-architecture/ —
# these cover the Melos + Flutter monorepo once ZOD-FND-001 stands it up)
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
**/build/
app.*.symbols
app.*.map.json
.melos_tool/
.fvm/

# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/android/app/*.jks
*.keystore

# iOS / macOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dot
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/

# Native (Swiss Ephemeris / astronomy-engine FFI build output, per ARCH-6)
native/**/build/
native/**/*.o
native/**/*.so
native/**/*.a
native/**/*.dylib
native/**/*.dll
native/**/CMakeFiles/
native/**/CMakeCache.txt

# Node (design-reference/zodiann/_source/render/ uses puppeteer-core per its README)
node_modules/
npm-debug.log*
package-lock.json

# Secrets / local environment — never commit these
.env
.env.*
*.pem
*.p12
*.key
!**/assets/**/*.key

# Test / coverage output
coverage/
*.lcov
.test_coverage/
